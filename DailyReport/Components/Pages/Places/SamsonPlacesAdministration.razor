@page "/samson/places"
@using DailyReport.Models
@using DailyReport.Services.Places

<PageTitle>Места(Самсон)</PageTitle>

<h1 class="page-title text-center">Места(Самсон)</h1>

@if (Departments.Count == 0)
{
    <div class="mx-auto mt-4 max-w-xl rounded-card border border-stroke bg-neutral-layer-2 p-6 text-center text-foreground-3 shadow-card">
        Отделений с палатами нет.
    </div>
}
else
{
    <div class="samson-index">
        @foreach (var dep in Departments)
        {
            <a href="@WardRoutes.SamsonDepartment(dep.Id)" class="fluent-link">@dep.Name</a>
        }
        <a href="@WardRoutes.SamsonDashboard" class="fluent-link">Вся больница</a>
    </div>
}
