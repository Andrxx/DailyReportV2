@page "/places/{DepartmentId:int}"
@using DailyReport.Models
@using DailyReport.Models.WardsModels

<PageTitle>Места</PageTitle>

<div class="max-w-[108rem] px-4 py-6">
    <p class="mb-2 text-sm"><a href="/places" class="fluent-link">&larr; Места</a></p>

    @if (Department is null)
    {
        <h1 class="page-title">Отделение не найдено</h1>
        <div class="mt-4 rounded-card border border-stroke bg-neutral-layer-2 p-6 text-center text-foreground-3 shadow-card">
            Отделения с идентификатором @DepartmentId нет.
        </div>
    }
    else
    {
        <h1 class="page-title">Размещение: @Department.Name</h1>

        @if (!IsWardDepartment)
        {
            <div class="mt-4 rounded-card border border-stroke bg-neutral-layer-2 p-6 text-center text-foreground-3 shadow-card">
                Отделение не участвует в размещении по палатам. Включите для него флаг «Палаты»
                на <a href="/admin/departments" class="fluent-link">странице отделений</a>.
            </div>
        }
        else
        {
            @if (!string.IsNullOrEmpty(Error))
            {
                <div class="mb-4 rounded-card border border-stroke bg-neutral-layer-2 p-3 text-sm text-foreground-1 shadow-card">
                    @Error
                </div>
            }

            @if (Cards.Count == 0)
            {
                <div class="mt-4 rounded-card border border-stroke bg-neutral-layer-2 p-6 text-center text-foreground-3 shadow-card">
                    Палат пока нет. Добавьте палаты в
                    <a href="/wards/@DepartmentId" class="fluent-link">администрировании палат</a>.
                </div>
            }
            else
            {
                <p class="mt-4 text-sm text-foreground-3">
                    Данные пациента вносятся прямо в строке палаты: пустая строка — «Сохранить»,
                    уже оформленный пациент — «Обновить»/«Удалить». Дата госпитализации заполняется
                    только при оформлении, дальше она не редактируется. Пациента можно перенести в
                    другую палату этого отделения, перетащив его за номер строки; перенос в закрытую
                    или переполненную палату спросит подтверждение.
                </p>

                <div class="mt-4 flex flex-col gap-4">
                    @foreach (var card in Cards)
                    {
                        <section class="place-card @card.StatusClass rounded-card border border-stroke shadow-card" data-drop-ward="@card.Ward.Number">
                            <header class="flex flex-wrap items-center justify-between gap-3 border-b border-stroke-divider px-4 py-3">
                                <div class="flex flex-wrap items-center gap-3">
                                    <h2 class="font-semibold text-foreground-1">Палата @card.Ward.Number</h2>
                                    <span class="place-status font-medium @card.StatusClass">@card.StatusText</span>
                                </div>
                                <div class="flex flex-wrap items-center gap-4 text-sm text-foreground-2">
                                    <span>Мест: @card.Ward.Capacity</span>
                                    <span class="place-counter">Пациентов: @card.Patients.Count из @card.Ward.Capacity</span>
                                    <span class="place-free">Свободно: @card.FreeSlots</span>
                                    <label class="flex items-center gap-2">
                                        <input type="checkbox" class="place-switch" checked="@(!card.Ward.CanPut)"
                                               @onchange="@(() => ToggleClosed(card.Ward))" /> закрыта
                                    </label>
                                    <button type="button" class="fluent-btn-standard" @onclick="() => AddRow(card)">+ добавить строку</button>
                                </div>
                            </header>

                            @if (card.Rows.Count == 0)
                            {
                                <div class="px-4 py-3 text-sm text-foreground-3">Мест не выделено.</div>
                            }
                            else
                            {
                                <div class="overflow-x-auto">
                                    <table class="w-full text-sm">
                                        <thead>
                                            <tr class="border-b border-stroke text-left text-foreground-2">
                                                <th class="w-10 px-3 py-2 font-medium">№</th>
                                                <th class="w-72 px-3 py-2 font-medium">ФИО</th>
                                                <th class="w-28 px-3 py-2 font-medium">Возраст</th>
                                                <th class="w-20 px-3 py-2 font-medium">Пол</th>
                                                <th class="w-80 px-3 py-2 font-medium">Диагноз</th>
                                                 <th class="w-44 px-3 py-2 font-medium">Дата госпитализации</th>
                                                <th class="w-72 px-3 py-2 font-medium">Признаки</th>
                                                <th class="w-56 px-3 py-2 font-medium">Действия</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @for (var i = 0; i < card.Rows.Count; i++)
                                            {
                                                var row = card.Rows[i];

                                                <tr class="border-b border-stroke-divider align-top last:border-0">
                                                    <td class="px-3 py-1 text-foreground-3">
                                                        @if (row.Exists)
                                                        {
                                                            <div class="place-drag-handle" draggable="true" data-patient-id="@row.Id"
                                                                 title="Перетащите, чтобы перенести пациента в другую палату">
                                                                <span>@(i + 1)</span>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            @(i + 1)
                                                        }
                                                    </td>
                                                    <td class="px-3 py-1">
                                                        <input class="fluent-input" placeholder="ФИО" @bind="row.Name" @bind:event="oninput" />
                                                    </td>
                                                    <td class="px-3 py-1">
                                                        <input class="fluent-input" placeholder="возраст" @bind="row.SAge" @bind:event="oninput" />
                                                    </td>
                                                    <td class="px-3 py-1">
                                                        <select class="fluent-input" @bind="row.Male">
                                                            <option value="М">М</option>
                                                            <option value="Ж">Ж</option>
                                                        </select>
                                                    </td>
                                                    <td class="px-3 py-1">
                                                        <input class="fluent-input" placeholder="диагноз" @bind="row.Diagnos" @bind:event="oninput" />
                                                    </td>
                                                    <td class="px-3 py-1">
                                                        @if (row.Exists)
                                                        {
                                                            <span class="text-foreground-2">@row.HospDateText</span>
                                                        }
                                                        else
                                                        {
                                                            <input type="date" class="fluent-input" @bind="row.HospDate" @bind:format="yyyy-MM-dd" />
                                                        }
                                                    </td>
                                                    <td class="px-3 py-1">
                                                        <div class="flex flex-nowrap items-center gap-3 text-xs whitespace-nowrap">
                                                            <label class="inline-flex items-center gap-1"><input type="checkbox" @bind="row.Rash" /> сыпь</label>
                                                            <label class="inline-flex items-center gap-1"><input type="checkbox" @bind="row.CareRisk" /> риск ВБИ</label>
                                                            <label class="inline-flex items-center gap-1"><input type="checkbox" @bind="row.Untouchable" /> от главного</label>
                                                        </div>
                                                    </td>
                                                    <td class="px-3 py-1 whitespace-nowrap">
                                                        @if (row.Exists)
                                                        {
                                                            <button type="button" class="fluent-btn-accent place-row-btn place-update" @onclick="() => SaveRow(card, row)">Обновить</button>
                                                            <button type="button" class="fluent-btn-standard place-row-btn place-row-btn-danger place-delete" @onclick="() => DeleteRow(row)">Удалить</button>
                                                        }
                                                        else
                                                        {
                                                            <button type="button" class="fluent-btn-accent place-row-btn place-save" @onclick="() => SaveRow(card, row)">Сохранить</button>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </section>
                    }
                </div>
            }
        }
    }
</div>
