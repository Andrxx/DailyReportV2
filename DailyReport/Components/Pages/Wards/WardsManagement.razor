@page "/wards/{DepartmentId:int}"
@using DailyReport.Models
@using DailyReport.Models.WardsModels

<PageTitle>Палаты отделения</PageTitle>

<div class="max-w-[90rem] px-4 py-6">
    <p class="mb-2 text-sm"><a href="/wards" class="fluent-link">&larr; Администрирование (палаты)</a></p>

    @if (Department is null)
    {
        <h1 class="page-title">Отделение не найдено</h1>
        <div class="mt-4 rounded-card border border-stroke bg-neutral-layer-2 p-6 text-center text-foreground-3 shadow-card">
            Отделения с идентификатором @DepartmentId нет.
        </div>
    }
    else
    {
        <h1 class="page-title">Палаты: @Department.Name</h1>

        @if (!IsWardDepartment)
        {
            <div class="mt-4 rounded-card border border-stroke bg-neutral-layer-2 p-6 text-center text-foreground-3 shadow-card">
                Отделение не участвует в размещении по палатам. Включите для него флаг «Палаты»
                на <a href="/admin/departments" class="fluent-link">странице отделений</a>.
            </div>
        }
        else
        {
            @if (!string.IsNullOrEmpty(Error))
            {
                <div class="mb-4 rounded-card border border-stroke bg-neutral-layer-2 p-3 text-sm text-foreground-1 shadow-card">
                    @Error
                </div>
            }

            @if (Wards.Count == 0)
            {
                <div class="mt-4 rounded-card border border-stroke bg-neutral-layer-2 p-6 text-center text-foreground-3 shadow-card">
                    Палат пока нет. Добавьте первую палату ниже.
                </div>
            }
            else
            {
                <div class="mt-4 overflow-x-auto rounded-card border border-stroke bg-neutral-layer-2 shadow-card">
                    <table class="w-full text-sm">
                        <thead>
                            <tr class="border-b border-stroke text-left text-foreground-2">
                                <th class="w-48 px-3 py-2 font-medium">Номер палаты</th>
                                <th class="w-32 px-3 py-2 font-medium">Мест</th>
                                <th class="px-3 py-2 text-right">Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ward in Wards)
                            {
                                <tr class="border-b border-stroke-divider last:border-0">
                                    <td class="px-3 py-1"><input type="text" required @bind="ward.Number" class="fluent-input" /></td>
                                    <td class="px-3 py-1"><input type="number" min="0" @bind="ward.Capacity" class="fluent-input" /></td>
                                    <td class="px-3 py-1 text-right whitespace-nowrap">
                                        <button type="button" @onclick="() => UpdateWard(ward)" class="fluent-icon-btn" title="Сохранить">&#9998;</button>
                                        <button type="button" @onclick="() => DeleteWard(ward)" class="fluent-icon-btn fluent-icon-btn-danger" title="Удалить">&#128465;</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div class="mt-6 rounded-card border border-stroke bg-neutral-layer-2 p-4 shadow-card">
                <h2 class="mb-3 font-semibold text-foreground-1">Добавить палату</h2>
                <div class="flex flex-wrap items-end gap-2">
                    <label class="flex w-48 flex-col gap-1 text-xs text-foreground-2">
                        Номер палаты
                        <input type="text" required @bind="NewNumber" class="fluent-input" placeholder="Номер палаты" />
                    </label>
                    <label class="flex w-32 flex-col gap-1 text-xs text-foreground-2">
                        Мест
                        <input type="number" min="0" @bind="NewCapacity" class="fluent-input" />
                    </label>
                    <button type="button" @onclick="AddWard" class="fluent-btn-accent">+ Добавить</button>
                </div>
                <p class="mt-3 text-xs text-foreground-3">
                    Номер уникален в пределах отделения. Переименование палаты переносит на новый
                    номер всех её пациентов. Палату с пациентами удалить нельзя.
                </p>
            </div>
        }
    }
</div>
