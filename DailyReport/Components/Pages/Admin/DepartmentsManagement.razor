@page "/admin/departments"
@using DailyReport.Models

<PageTitle>Управление отделениями</PageTitle>

<div class="max-w-[108rem] px-4 py-6">
    <p class="mb-2 text-sm"><a href="/admin" class="fluent-link">&larr; Администрирование</a></p>
    <h1 class="page-title">Управление отделениями</h1>

    @if (Departments.Count == 0)
    {
        <div class="mt-4 rounded-card border border-stroke bg-neutral-layer-2 p-6 text-center text-foreground-3 shadow-card">
            Отделений нет. Добавьте первое отделение ниже.
        </div>
    }
    else
    {
        <div class="mt-4 overflow-x-auto rounded-card border border-stroke bg-neutral-layer-2 shadow-card">
            <table class="w-full text-sm">
                <thead>
                    <tr class="border-b border-stroke text-left text-foreground-2">
                        <th class="px-3 py-2 font-medium">Название отделения</th>
                        <th class="px-3 py-2 font-medium">Порядок в сводке</th>
                        <th class="px-3 py-2 font-medium">Палат</th>
                        <th class="px-3 py-2 font-medium">Взрослых коек</th>
                        <th class="px-3 py-2 font-medium">Детских коек</th>
                        <th class="px-3 py-2 font-medium">Тип</th>
                        <th class="px-3 py-2 text-right">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var dep in Departments)
                    {
                        <tr class="border-b border-stroke-divider last:border-0">
                            <td class="px-3 py-1"><input type="text" required @bind="dep.Name" class="fluent-input" /></td>
                            <td class="px-3 py-1"><input type="number" required @bind="dep.ShowOrder" class="fluent-input w-20" /></td>
                            <td class="px-3 py-1"><input type="number" min="0" @bind="dep.WardQuantity" class="fluent-input w-20" /></td>
                            <td class="px-3 py-1"><input type="number" min="0" @bind="dep.AdultSpotsQuantity" class="fluent-input w-20" /></td>
                            <td class="px-3 py-1"><input type="number" min="0" @bind="dep.ChildrenSpotsQuantity" class="fluent-input w-20" /></td>
                            <td class="px-3 py-1">
                                @if (dep.Settings is not null)
                                {
                                    <select class="fluent-input w-32" @bind="dep.Settings.Type" @bind:after="() => SaveType(dep)">
                                        <option value="@DepartmentType.General">Обычное</option>
                                        <option value="@DepartmentType.DayCare">Дневной стационар</option>
                                        <option value="@DepartmentType.KDO">КДО</option>
                                        <option value="@DepartmentType.PayService">Платные услуги</option>
                                        <option value="@DepartmentType.ORIT">ОРИТ</option>
                                        <option value="@DepartmentType.ORITDirty">ОРИТ (грязная)</option>
                                        <option value="@DepartmentType.Laboratory">Лаборатория</option>
                                        <option value="@DepartmentType.Security">Охрана</option>
                                        <option value="@DepartmentType.Xray">Рентген</option>
                                        <option value="@DepartmentType.Utility">Хозблок</option>
                                    </select>
                                }
                                else
                                {
                                    <span class="text-foreground-3">—</span>
                                }
                            </td>
                            <td class="px-3 py-1 text-right whitespace-nowrap">
                                <button type="button" @onclick="() => UpdateDepartment(dep)" class="fluent-icon-btn" title="Сохранить">&#9998;</button>
                                <button type="button" @onclick="() => DeleteDepartment(dep)" class="fluent-icon-btn fluent-icon-btn-danger" title="Удалить">&#128465;</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="mt-6 rounded-card border border-stroke bg-neutral-layer-2 p-4 shadow-card">
        <h2 class="mb-3 font-semibold text-foreground-1">Добавить отделение</h2>
        <div class="flex flex-wrap items-end gap-2">
            <label class="flex w-[13.25rem] flex-col gap-1 text-xs text-foreground-2">
                Название отделения
                <input type="text" required @bind="NewDepartment.Name" class="fluent-input" placeholder="Название отделения" />
            </label>
            <label class="flex flex-col gap-1 text-xs text-foreground-2">
                Порядок в сводке
                <input type="number" required @bind="NewDepartment.ShowOrder" class="fluent-input w-24" />
            </label>
            <label class="flex flex-col gap-1 text-xs text-foreground-2">
                Палат
                <input type="number" min="0" @bind="NewDepartment.WardQuantity" class="fluent-input w-24" />
            </label>
            <label class="flex flex-col gap-1 text-xs text-foreground-2">
                Взрослых коек
                <input type="number" min="0" @bind="NewDepartment.AdultSpotsQuantity" class="fluent-input w-24" />
            </label>
            <label class="flex flex-col gap-1 text-xs text-foreground-2">
                Детских коек
                <input type="number" min="0" @bind="NewDepartment.ChildrenSpotsQuantity" class="fluent-input w-24" />
            </label>
            <button type="button" @onclick="AddDepartment" class="fluent-btn-accent">+ Добавить</button>
        </div>
    </div>

    <div class="mt-6 rounded-card border border-stroke bg-neutral-layer-2 p-4 shadow-card">
        <h2 class="mb-3 font-semibold text-foreground-1">Настройки показа отделений</h2>

        @if (SettingsTableExists)
        {
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="border-b border-stroke text-left text-foreground-2">
                            <th class="px-3 py-2 font-medium">Отделение</th>
                            <th class="px-3 py-2 font-medium">Главная страница</th>
                            <th class="px-3 py-2 font-medium">Общая сводка (колонка)</th>
                            <th class="px-3 py-2 font-medium">Койки в сводке</th>
                            <th class="px-3 py-2 font-medium">Пожарная сводка</th>
                            <th class="px-3 py-2 font-medium">Палаты</th>
                            <th class="px-3 py-2 font-medium">Упрощённая форма</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var dep in Departments)
                        {
                            if (dep.Settings is not null)
                            {
                                <tr class="border-b border-stroke-divider last:border-0">
                                    <td class="px-3 py-1 font-medium text-foreground-1">@dep.Name</td>
                                    <td class="px-3 py-1"><input type="checkbox" checked="@dep.Settings.ShowOnMainPage" @onchange='(e) => ToggleSettings(dep, nameof(DepartmentSettings.ShowOnMainPage), e.Value is bool ? (bool)e.Value : false)' /></td>
                                    <td class="px-3 py-1"><input type="checkbox" checked="@dep.Settings.ShowOnFinalReport" @onchange='(e) => ToggleSettings(dep, nameof(DepartmentSettings.ShowOnFinalReport), e.Value is bool ? (bool)e.Value : false)' /></td>
                                    <td class="px-3 py-1"><input type="checkbox" checked="@dep.Settings.CountSpotsInFinalReport" @onchange='(e) => ToggleSettings(dep, nameof(DepartmentSettings.CountSpotsInFinalReport), e.Value is bool ? (bool)e.Value : false)' /></td>
                                    <td class="px-3 py-1"><input type="checkbox" checked="@dep.Settings.ShowOnFireReport" @onchange='(e) => ToggleSettings(dep, nameof(DepartmentSettings.ShowOnFireReport), e.Value is bool ? (bool)e.Value : false)' /></td>
                                    <td class="px-3 py-1"><input type="checkbox" checked="@dep.Settings.ShowOnWards" @onchange='(e) => ToggleSettings(dep, nameof(DepartmentSettings.ShowOnWards), e.Value is bool ? (bool)e.Value : false)' /></td>
                                    <td class="px-3 py-1"><input type="checkbox" checked="@dep.Settings.SimpleReportForm" @onchange='(e) => ToggleSettings(dep, nameof(DepartmentSettings.SimpleReportForm), e.Value is bool ? (bool)e.Value : false)' /></td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <p class="mt-3 text-xs text-foreground-3">Изменения сохраняются сразу при переключении.</p>
        }
        else
        {
            <p class="text-sm text-foreground-3">
                Таблица DepartmentSettings ещё не создана: миграция не выполнена. Накатите миграцию на
                <a href="/admin/migration" class="fluent-link">странице миграции БД</a> и вернитесь на эту страницу.
            </p>
        }
    </div>

    <div class="mt-4 max-w-4xl text-sm text-foreground-3">
        <p class="mb-1">Название отделения может быть любым, должно нести смысловую нагрузку.</p>
        <p class="mb-1">Алиас отделения присваивается автоматически — равен идентификатору (Id). Это поле
            зарезервировано для обратной совместимости и в интерфейсе не показывается.</p>
        <p>Порядок в сводке — номер сортировки отделений в сводке, номера не должны совпадать. Тип и флаги показа управляют включением отделения в страницы, раньше это делалось списками исключений.</p>
    </div>
</div>