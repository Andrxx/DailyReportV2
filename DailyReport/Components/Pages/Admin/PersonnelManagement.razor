@page "/admin/personnel"
@using DailyReport.Models.PersonelFolder

<PageTitle>Справочник персонала</PageTitle>

<div class="max-w-[90rem] px-4 py-6">
    <p class="mb-2 text-sm"><a href="/admin" class="fluent-link">&larr; Администрирование</a></p>
    <h1 class="page-title">Справочник персонала</h1>
    <p class="mb-4 max-w-4xl text-sm text-foreground-3">
        Один и тот же человек нельзя завести дважды с одинаковой должностью: в отчёте
        два одинаковых ФИО неразличимы.
    </p>

    @if (!string.IsNullOrEmpty(Error))
    {
        <div class="mb-4 rounded-card border border-stroke bg-neutral-layer-2 p-3 text-sm text-foreground-1 shadow-card">
            @Error
        </div>
    }

    <datalist id="personelTypes">
        @foreach (var type in PersTypes)
        {
            <option value="@type">@type</option>
        }
    </datalist>
    <datalist id="personnelDepartments">
        @foreach (var dep in Departments)
        {
            if (!string.IsNullOrEmpty(dep))
            {
                <option value="@dep">@dep</option>
            }
        }
    </datalist>

    <div class="mt-4 rounded-card border border-stroke bg-neutral-layer-2 p-4 shadow-card">
        <h2 class="mb-3 font-semibold text-foreground-1">Добавить сотрудника</h2>
        <div class="flex flex-wrap items-end gap-2">
            <label class="flex flex-col gap-1 text-xs text-foreground-2">
                ФИО
                <input type="text" required @bind="NewPersonel.Name" class="fluent-input w-[22.5rem]" placeholder="Фамилия Имя Отчество" />
            </label>
            <label class="flex flex-col gap-1 text-xs text-foreground-2">
                Телефон
                <input type="text" @bind="NewPersonel.Phone" class="fluent-input w-44" />
            </label>
            <label class="flex flex-col gap-1 text-xs text-foreground-2">
                Должность
                <span class="flex items-center gap-2">
                    <select class="fluent-input w-36" value="@PersTypeSelect" @onchange="OnPersTypeSelect" title="Выбрать из пресетов">
                        <option value="">—</option>
                        @foreach (var type in PersTypes)
                        {
                            <option value="@type">@type</option>
                        }
                    </select>
                    <input type="text" required value="@NewPersonel.PersType" @oninput="OnPersTypeInput"
                           class="fluent-input w-40" placeholder="Врач" title="Должность: можно ввести свою" />
                </span>
            </label>
            <label class="flex flex-col gap-1 text-xs text-foreground-2">
                Подразделение
                <span class="flex items-center gap-2">
                    <select class="fluent-input w-56" value="@DepartmentSelect" @onchange="OnDepartmentSelect" title="Выбрать из отделений">
                        <option value="">—</option>
                        @foreach (var dep in Departments)
                        {
                            <option value="@dep">@dep</option>
                        }
                    </select>
                    <input type="text" value="@NewPersonel.Department" @oninput="OnDepartmentInput"
                           class="fluent-input w-40" placeholder="ОРИТ" title="Подразделение: можно ввести своё" />
                </span>
            </label>
            <button type="button" @onclick="AddPersonel" class="fluent-btn-accent">+ Добавить</button>
        </div>
        <p class="mt-3 text-xs text-foreground-3">
            Должность выбирается пресетом из конфига или вводится строкой — любое значение
            сохранится, как и правка должности у существующего сотрудника. Подразделение —
            список всех отделений больницы; можно ввести и своё значение.
        </p>
    </div>

    @if (Personels.Count == 0)
    {
        <div class="mt-4 rounded-card border border-stroke bg-neutral-layer-2 p-6 text-center text-foreground-3 shadow-card">
            Справочник пуст. Добавьте первого человека выше.
        </div>
    }
    else
    {
        <div class="mt-4 overflow-x-auto rounded-card border border-stroke bg-neutral-layer-2 shadow-card">
            <table class="w-full text-sm">
                <thead>
                    <tr class="border-b border-stroke text-left text-foreground-2">
                        <th class="px-3 py-2 font-medium">ФИО</th>
                        <th class="px-3 py-2 font-medium">Телефон</th>
                        <th class="px-3 py-2 font-medium">Должность</th>
                        <th class="px-3 py-2 font-medium">Подразделение</th>
                        <th class="px-3 py-2 text-right">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var person in Personels)
                    {
                        <tr class="border-b border-stroke-divider last:border-0">
                            <td class="px-3 py-1"><input type="text" required @bind="person.Name" class="fluent-input" /></td>
                            <td class="px-3 py-1"><input type="text" @bind="person.Phone" class="fluent-input w-40" /></td>
                            <td class="px-3 py-1">
                                <input type="text" required list="personelTypes" @bind="person.PersType" class="fluent-input w-56" />
                            </td>
                            <td class="px-3 py-1">
                                <input type="text" list="personnelDepartments" @bind="person.Department" class="fluent-input w-56" />
                            </td>
                            <td class="px-3 py-1 text-right whitespace-nowrap">
                                <button type="button" @onclick="() => UpdatePersonel(person)" class="fluent-icon-btn" title="Сохранить">&#9998;</button>
                                <button type="button" @onclick="() => DeletePersonel(person.Id)" class="fluent-icon-btn fluent-icon-btn-danger" title="Удалить">&#128465;</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
